# NOVA/MARKET environment variables
# Copy this file to .env.local for local development.
# Never commit real credentials or production values.

# =============================================================================
# Database
# =============================================================================
# REQUIRED FOR PRODUCTION, build, migrations, and runtime Prisma access.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# =============================================================================
# Authentication
# =============================================================================
# REQUIRED FOR PRODUCTION authentication and signed sessions.
NEXTAUTH_SECRET="generate-a-long-random-secret"
# REQUIRED FOR PRODUCTION. Must be an absolute URL, for example:
# https://your-production-domain.example
NEXTAUTH_URL="https://your-production-domain.example"

# =============================================================================
# Application URLs
# =============================================================================
# REQUIRED FOR PRODUCTION metadata, sitemap, robots, checkout redirects,
# and transactional email links. Must be an absolute URL.
NEXT_PUBLIC_APP_URL="https://your-production-domain.example"

# OPTIONAL. Used in structured metadata; the application has a branded fallback.
NEXT_PUBLIC_APP_NAME="NOVA/MARKET"

# =============================================================================
# Stripe
# =============================================================================
# REQUIRED FOR checkout, payment-session retrieval, and payment processing.
STRIPE_SECRET_KEY="sk_live_REPLACE_WITH_YOUR_KEY"

# REQUIRED ONLY FOR STRIPE WEBHOOK VERIFICATION if
# /api/stripe/webhook is used. The current checkout confirmation flow does not
# require this value, but the webhook route does.
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_YOUR_SECRET"

# =============================================================================
# Email / Resend
# =============================================================================
# REQUIRED ONLY FOR transactional email features:
# password reset, order confirmation, welcome email, and low-stock alerts.
RESEND_API_KEY="re_REPLACE_WITH_YOUR_KEY"
EMAIL_FROM="noreply@your-domain.example"

# REQUIRED ONLY FOR NextAuth email sign-in. The EmailProvider is implemented,
# but these SMTP values are not needed for credentials or Google sign-in.
EMAIL_SERVER_HOST="smtp.your-provider.example"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="smtp-user"
EMAIL_SERVER_PASSWORD="smtp-password"

# =============================================================================
# Admin
# =============================================================================
# REQUIRED ONLY FOR low-stock alert recipients and seed-time admin setup.
ADMIN_EMAIL="admin@your-domain.example"

# =============================================================================
# Image Storage
# =============================================================================
# REQUIRED ONLY FOR production admin image uploads. All four AWS values must
# be configured together. Without them, local development uses public files;
# production uploads fail clearly.
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"

# OPTIONAL when using S3. If omitted, the uploader uses the default S3 URL.
CDN_URL="https://cdn.your-domain.example"

# =============================================================================
# Revalidation
# =============================================================================
# REQUIRED ONLY when calling /api/revalidate. Requests without this secret
# are rejected; the endpoint is not needed for normal storefront operation.
REVALIDATE_SECRET="generate-a-separate-random-secret"

# =============================================================================
# OAuth
# =============================================================================
# REQUIRED ONLY for Google sign-in. Credentials sign-in does not use these.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# =============================================================================
# Optional integrations
# =============================================================================
# OPTIONAL. When true in production, proxy.ts redirects HTTP requests to HTTPS.
FORCE_HTTPS="false"

# Set automatically by Next.js/Vercel; normally do not configure manually.
NODE_ENV="development"

# Vercel supplies VERCEL automatically. It is used by next.config.mjs to
# disable standalone output on Vercel while preserving standalone elsewhere.
